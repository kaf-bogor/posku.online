{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poskubogor",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "poskubogor.com",
    "TURNSTILE_ACTION": "site-access"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
