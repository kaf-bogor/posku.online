# Firebase service account (hanya untuk scripts/firestore-export.mjs)
# Isi salah satu: path ke file service account JSON, atau JSON lengkap.
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/ke/service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Google OAuth (login admin; tanpa Firebase). Redirect URI terdaftar:
#   https://poskubogor.com/api/auth/callback/google
#   http://localhost:4001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL worker D1 (opsional; default sudah terisi)
# NEXT_PUBLIC_D1_API_URL=https://posku-d1.kubido.workers.dev
