# Google OAuth (login admin). Redirect URI terdaftar:
#   https://poskubogor.com/api/auth/callback/google
#   http://localhost:4001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL worker D1 (opsional; default sudah terisi)
# NEXT_PUBLIC_D1_API_URL=https://posku-d1.kubido.workers.dev

# Cloudflare Web Analytics (opsional). Token dari dashboard Cloudflare →
# Web Analytics → tambah site. Bila kosong, beacon tidak dimuat.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
