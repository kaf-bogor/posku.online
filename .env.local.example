# Cloudflare R2 (image storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional overrides (defaults below already set in code):
# R2_ACCOUNT_ID=27a967e72df3a8b03d272cab0cd7a213
# R2_BUCKET_NAME=kuttab
# R2_PUBLIC_URL=https://files.rifkifauzi.id

# Firebase service account (hanya untuk scripts/firestore-export.mjs)
# Isi salah satu: path ke file service account JSON, atau JSON lengkap.
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/ke/service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
