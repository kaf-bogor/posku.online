{
  "name": "poskubogor",
  "version": "0.1.0",
  "private": true,
  "author": "sozonome",
  "scripts": {
    "dev": "vinext dev --port 4001",
    "build": "vinext build",
    "turbo": "pnpm dlx turbo@2.0.9",
    "build:turbo": "pnpm turbo run build",
    "start": "vinext start",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && pnpm format",
    "type-check": "tsc --noEmit",
    "check:turbo": "pnpm turbo lint type-check",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "release": "cross-env HUSKY=0 standard-version",
    "push-release": "git push --follow-tags origin main",
    "prepare": "husky",
    "rag:docs": "node scripts/load-rag-docs.mjs",
    "rag:docs:apply": "node scripts/load-rag-docs.mjs --apply",
    "test": "vitest run"
  },
